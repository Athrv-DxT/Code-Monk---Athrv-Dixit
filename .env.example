# ==============================================================================
# INTELLIX - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM API Keys
# Gemini API Key (Primary): Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Rotating Gemini keys (automatic Round Robin & Circuit Breaker)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Groq API Key (Fallback): Get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Rotating Groq keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Retrieval Fallback
# Tavily API Key: Get a free key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Neo4j Database Configuration
# In docker-compose, the host is 'neo4j'. For local development outside docker, use 'localhost'.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=intellix_secure_pass_123

# Port Configuration
PORT=8000
HOST=0.0.0.0

# Optional: Environment (development | production)
ENV=development
